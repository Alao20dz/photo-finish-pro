# Supabase — القيم الحقيقية تُوضع في .env فقط (لا يُرفع أبداً إلى git)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX
# اسم بديل متوافق مع supabase/README.md (نفس قيمة المفتاح العام)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# قاعدة البيانات عبر Prisma — عند الانتقال إلى Supabase استخدم سلسلة الاتصال من
# Dashboard > Project Settings > Database (يفضَّل Connection Pooler للنشر)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
