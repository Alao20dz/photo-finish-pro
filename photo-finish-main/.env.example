# ==============================================================================
# متغيرات البيئة لنظام PHOTO FINISH PRO – Athletics Management System
# ==============================================================================
# NOTE أمني: لا توجد أي كلمات مرور أو مفاتيح سرية داخل المستودع (Zero Backdoors).
# كل ما يوجد هنا قِيَم مثال يجب استبدالها في الإنتاج.

# 1. إعدادات الأمان والمصادقة الإدارية (Server Security)
# كلمة مرور دخول لوحة الإدارة العليا (ADMIN SUITE) — إلزامية في الإنتاج.
# إذا تُركت فارغة، يولّد الخادم كلمة عشوائية عند الإقلاع ويطبعها في الطرفية مرة واحدة:
ADMIN_PORTAL_PASSWORD=ChangeThisToAStrongAdminPassword2026!

# مفتاح التوقيع غير المتماثل Ed25519 (Private Key) - خاص بالخادم حصراً.
# يستحيل تزوير أي ترخيص دون هذا المفتاح. ولّد مفتاحاً جديداً خاصاً بك:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).subarray(16).toString('base64'))"
# إذا تُرك فارغاً: يولّد الخادم زوج مفاتيح جديداً عند أول إقلاع ويحفظه في data/license-keys.json (gitignored).
LICENSE_PRIVATE_KEY_BASE64=
LICENSE_PUBLIC_KEY_BASE64=

# 2. المفتاح العام Ed25519 للعميل (Client Verification Key)
# يُضمّن في المتصفح للتحقق من سلامة التراخيص ورموز نقاط المراقبة أوفلاين.
# IMPORTANT: يجب أن يطابق المفتاح الخاص أعلاه، وإلا سيرفض التطبيق كل ترخيص جديد.
# في التطوير يمكن تركه فارغاً — يُجلب تلقائياً من الخادم /api/public-key (Trust-On-First-Use):
VITE_LICENSE_PUBLIC_KEY=

# 3. خادم الترحيل السحابي (Relay Server)
# اختياري: انشر خادمك من مجلد relay-server على Railway/Render ثم ضع الرابط هنا:
# VITE_RELAY_WS_URL=wss://photo-finish-relay.up.railway.app
# عنوان خادم المزامنة الخلفي (REST Sync API) — نفس خادم الترحيل عادةً:
# VITE_SYNC_API_URL=https://photo-finish-relay.up.railway.app
PORT=3001
